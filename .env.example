# Copy to .env for local configuration. Never commit real secrets.
PORT=5000
NODE_ENV=development
# Optional: MongoDB Atlas URI. If unset, local JSON persistence is used.
MONGODB_URI=
# Optional: set this in production to your exact frontend origin, e.g. https://brandshield.example.com
FRONTEND_ORIGIN=
# Optional source integrations require their own approved credentials and access.
# Do not paste credentials into source files.
# Optional: enables public-web search for social profiles and Google Play listings.
# Obtain a key from SerpAPI and keep it only on the backend.
SERPAPI_API_KEY=
